# Copy to .env and fill in real values.

# --- Database (docker-compose: service "db") ---
DATABASE_URL="postgresql://roamit:roamit@localhost:5432/roamit?schema=public"

# --- CORS ---
# 허용할 origin 목록(쉼표로 구분, 공백 무관). 목록에 없는 origin 은 차단됩니다.
# 로컬 개발 시 프론트엔드(roamit)는 http://localhost:3001 에서 실행됩니다.
CORS_ORIGIN="http://localhost:3001"
# 쿠키 등 credentials 를 포함한 요청 허용 여부
CORS_CREDENTIALS="true"

# --- Auth: Google OAuth ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# --- Auth: JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
